DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,web
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

POSTGRES_DB=stockapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stockapp

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

SEED_ADMIN_PASSWORD=change-me-admin
SEED_ANALYST_PASSWORD=change-me-analyst
SEED_VIEWER_PASSWORD=change-me-viewer

LOG_LEVEL=INFO
CRAWLER_USER_AGENT=StockAppBot/0.1 (+https://localhost; research crawler)
CRAWL_NEWS_MINUTES=30
CRAWL_PRICES_HOUR=15
CRAWL_PRICES_MINUTE=0
CRAWL_FLOORSHEET_HOUR=15
CRAWL_FLOORSHEET_MINUTE=15
ANALYSIS_HOUR=15
ANALYSIS_MINUTE=45
MARKET_PRICE_DAYS=30
MARKET_FLOORSHEET_DAYS=3
NEPSE_TLS_VERIFY=false
CRAWLER_MEROLAGANI_ENABLED=true
CRAWLER_MEROLAGANI_USE_SELENIUM=true
CRAWLER_MEROLAGANI_MAX_PAGES=5
CRAWLER_SHARESANSAR_ENABLED=true
CRAWLER_BIZMANDU_ENABLED=true
CRAWLER_NEPSEALPHA_ENABLED=false

NEXT_PUBLIC_API_URL=http://localhost:8000
DJANGO_SETTINGS_MODULE=config.settings
BACKEND_PORT=8000
FRONTEND_PORT=3000
